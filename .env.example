# ==============================================================================
# Meu Portal Mandarim (Tao Ch'an) — Portfolio & Production Configuration
# ==============================================================================
#
# By default, the repository runs in Interactive Portfolio Sandbox Mode
# (`NEXT_PUBLIC_DEMO_MODE=true`), which intercepts Supabase REST, Auth, and
# Storage calls locally in the browser (`localStorage`) + static seed data,
# requiring ZERO external credentials to run `npm run dev` or `npm run build`.
#
# To connect to a live Supabase PostgreSQL instance instead:
# 1. Copy this file to `.env.local`
# 2. Set `NEXT_PUBLIC_DEMO_MODE=false`
# 3. Apply `supabase/migrations/20260901000000_initial_schema.sql` to your project
# 4. Fill in your Supabase project credentials below
# ==============================================================================

NEXT_PUBLIC_DEMO_MODE=true

# Supabase Connection (automatically mocked when NEXT_PUBLIC_DEMO_MODE=true)
NEXT_PUBLIC_SUPABASE_URL=https://portfolio-demo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-anon-key-portfolio-showcase
SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key-portfolio-showcase

# Optional: PostHog Telemetry & Session Replay (Admin Activity Log)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
